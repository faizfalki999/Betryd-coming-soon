# Vercel Serverless Function Environment Variables for Brevo (Sendinblue)
# Configure these in your Vercel Project Settings -> Environment Variables

# Get your API Key from Brevo Dashboard -> Account -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Brevo List ID to add contacts to (e.g. List ID 2 for BETRYD Early Access)
BREVO_LIST_ID=2
